# Shopify store domain. mock.shop is a tokenless demo store; swap for your-store.myshopify.com.
PUBLIC_STORE_DOMAIN=mock.shop
# Add once the app targets a real store:
# PUBLIC_STOREFRONT_API_TOKEN=
# PRIVATE_STOREFRONT_API_TOKEN=
PUBLIC_STOREFRONT_ID=0
# Required for ShopifyScripts and the Customer Account API (numeric shop ID):
# SHOP_ID=
# PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
# CUSTOMER_ACCOUNT_SESSION_SECRET=

# Product handles for the three jars on the home page (defaults shown).
# Create products with these handles in Shopify, each with 250g and 500g variants.
# JAR_HANDLE_CHUNKY=chunky-peanut-butter
# JAR_HANDLE_RECOVER=recover-chocolate-peanut-butter
# JAR_HANDLE_ENERGY=energy-peanut-butter
